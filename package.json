{
  "author": "ChaosLee",
  "bugs": {
    "url": "https://github.com/produck/kitty/issues"
  },
  "description": "Web application using kit.",
  "devDependencies": {
    "@eslint/config-helpers": "0.7.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@produck/agent-toolkit": "0.11.3",
    "@produck/eslint-rules": "0.4.2",
    "@types/node": "^25.9.1",
    "c8": "12.0.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lerna": "10.0.1",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.1"
  },
  "homepage": "https://github.com/produck/kitty#readme",
  "license": "MIT",
  "name": "@produck/kitty-workspace",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/produck/kitty.git"
  },
  "scripts": {
    "prepare": "husky",
    "produck:baseline": "npm exec --package=@produck/agent-toolkit@latest -- agent-toolkit enforce-node-baseline --cwd . && npm run produck:install",
    "produck:commit:check": "npm run produck:format && npm run produck:lint",
    "produck:coverage": "c8 --config .c8rc.json npm run test --workspaces --if-present",
    "produck:format": "prettier --write . --ignore-path .prettierignore --ignore-path .gitignore",
    "produck:install": "npm -v && npm install",
    "produck:lint": "eslint --fix . --max-warnings=0",
    "produck:publish": "npm run produck:publish:check && npm run publish --",
    "produck:publish:check": "npm run produck:install && npm run produck:coverage && npm run produck:commit:check",
    "test": "npm run test --workspaces --if-present"
  },
  "version": "0.0.0",
  "workspaces": [
    "packages/workflow",
    "packages/adaptor/http2",
    "packages/adaptor/http1.1/http",
    "packages/adaptor/http1.1/https",
    "packages/handler/method",
    "packages/handler/cookie",
    "packages/handler/request-type",
    "packages/handler/request-content-negotiation",
    "packages/handler/response-type",
    "packages/handler/status",
    "packages/kitty"
  ]
}
